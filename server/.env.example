# MongoDB connection string (local instance or Atlas SRV URI)
MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot

# Secret used to sign/verify JWTs. Use a long, random value (32+ characters),
# e.g. generated with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Optional; defaults to 5000. Render supplies this automatically in production.
PORT=5000

# ── Document storage ─────────────────────────────────────────────────────────
# Driver: "s3" | "local" | "memory". Defaults to "local" in development and
# "s3" in production.
#
# IMPORTANT: "local" is for development ONLY. Render's disk is ephemeral —
# every deploy/restart wipes it, silently losing every uploaded document.
# Production must use STORAGE_DRIVER=s3 with a PRIVATE bucket.
#STORAGE_DRIVER=local

# Where the local driver writes files. Defaults to server/uploads (gitignored).
#LOCAL_STORAGE_DIR=

# S3-compatible credentials (required when STORAGE_DRIVER=s3). Works with AWS
# S3 as-is; for Cloudflare R2 (recommended: zero egress fees) also set
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
# and S3_FORCE_PATH_STYLE=true.
#S3_BUCKET=
#S3_REGION=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_ENDPOINT=
#S3_FORCE_PATH_STYLE=false

# Upload limits. Optional; defaults: 5 MB per file, 10 documents per application.
#MAX_FILE_SIZE=5242880
#MAX_FILES_PER_APPLICATION=10
